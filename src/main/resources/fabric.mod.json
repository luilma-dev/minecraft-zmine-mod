{
	"schemaVersion": 1,
	"id": "zmine",
	"version": "${version}",
	"name": "ZMine",
	"description": "Sobrevivência em cidades devastadas, com estradas, rios, bases militares, ruínas, suprimentos e sistema de sede.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/zmine/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.zmine.ZMineMod"
		],
		"client": [
			"com.zmine.client.ZMineModClient"
		]
	},
	"mixins": [
		"zmine.mixins.json",
		{
			"config": "zmine.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
